# Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# ===========================================
# ENVIRONMENT
# ===========================================
NODE_ENV=production
PORT=5000

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# For MongoDB Atlas (Recommended for production):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/stockest?retryWrites=true&w=majority
# For local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/stock-simulator
MONGODB_URI=mongodb://localhost:27017/stock-simulator

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generate a strong random secret (use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=your-secure-jwt-secret-key-here

# ===========================================
# UPSTOX API CONFIGURATION (OAuth 2.0)
# ===========================================
# Get these from: https://developer.upstox.com/
UPSTOX_API_KEY=your-upstox-api-key-here
UPSTOX_API_SECRET=your-upstox-api-secret-here

# This should be your deployed backend URL + /api/upstox/callback
# For Render: https://your-backend-name.onrender.com/api/upstox/callback
# For local development: http://localhost:5000/api/upstox/callback
UPSTOX_REDIRECT_URI=http://localhost:5000/api/upstox/callback

# Legacy: Access token (optional - will be managed automatically by OAuth)
UPSTOX_ACCESS_TOKEN=your-upstox-access-token-here

# ===========================================
# EXTERNAL API KEYS
# ===========================================
# Get from: https://docs.perplexity.ai/
PERPLEXITY_API_KEY=your-perplexity-api-key-here

# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key-here

# ===========================================
# MARKET CONFIGURATION
# ===========================================
# Stock price update interval (milliseconds)
STOCK_UPDATE_INTERVAL=30000

# Market hours (IST)
MARKET_OPEN_TIME=09:15
MARKET_CLOSE_TIME=15:30

# News update interval (milliseconds) - 4 hours
NEWS_UPDATE_INTERVAL=14400000

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# For production, set this to your frontend URL
# For Render: https://your-frontend-name.onrender.com
# For local: http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Session secret (generate random string)
SESSION_SECRET=your-session-secret-key-here

# ===========================================
# DATABASE TUNING
# ===========================================
DB_CONNECTION_TIMEOUT=30000
DB_MAX_POOL_SIZE=10
