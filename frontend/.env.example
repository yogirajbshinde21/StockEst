# Frontend Environment Configuration
# Copy this file to .env and fill in your actual values

# ===========================================
# API CONFIGURATION
# ===========================================
# For production (Render), use your backend URL:
# REACT_APP_API_BASE_URL=https://your-backend-name.onrender.com
# For local development:
REACT_APP_API_BASE_URL=http://localhost:5000

# ===========================================
# SOCKET.IO CONFIGURATION
# ===========================================
# For production (Render), use your backend URL:
# REACT_APP_SOCKET_URL=https://your-backend-name.onrender.com
# For local development:
REACT_APP_SOCKET_URL=http://localhost:5000

# ===========================================
# ENVIRONMENT
# ===========================================
REACT_APP_NODE_ENV=development

# ===========================================
# APP CONFIGURATION
# ===========================================
REACT_APP_NAME=StockEst
REACT_APP_VERSION=1.0.0

# ===========================================
# FEATURE FLAGS
# ===========================================
REACT_APP_ENABLE_CHAT=true
REACT_APP_ENABLE_NEWS=true
REACT_APP_ENABLE_ACHIEVEMENTS=true
